#AddHandler application/x-httpd-ea-php82___lsphp .php
#AddHandler application/x-httpd-php5 .php

# disable directory browsing
Options -Indexes
Options +FollowSymLinks

RewriteEngine On
RewriteBase /

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_USER_AGENT} ^(.+)$
RewriteCond %{HTTP_HOST} ^academichub\.hostdivine\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.academichub\.hostdivine\.com$
RewriteRule .* https://academichub.hostdivine.com%{REQUEST_URI} [R=301,L]
Header add Strict-Transport-Security "max-age=300"



RewriteRule ^about/(.*)/ about.php?slug=$1
RewriteRule ^about/(.*)$ about.php?slug=$1
RewriteRule ^about/ about.php
RewriteRule ^about$ about.php

